mode=$(printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$DYN" "$FIX" "$NEW" "$SUR" "$FNT" "$CUR" "$WIN" "$TAB" | fzf \
    --height=60% --layout=reverse --border=rounded \
    --prompt='modo › ' \
    --header="kitty   ·   color actual: $current_color   ·   fuente actual: $current_font
↑/↓ moverse · Enter elegir · Esc salir" \
    --header-first)

case "$mode" in
    "$DYN") set_dynamic ;;
    "$FIX")
        sel="$(pick_theme)"
        if [ -n "$sel" ]; then set_fixed "$sel"; else echo "Sin cambios."; fi
        ;;
    "$NEW") create_custom_theme ;;
    "$SUR") surprise_theme ;;
    "$FNT")
        sel="$(pick_font)"
        if [ -n "$sel" ]; then set_font "$sel"; else echo "Sin cambios."; fi
        ;;
    "$CUR") pick_cursor ;;
    "$WIN") pick_window ;;
    "$TAB") pick_tabs ;;
    *) echo "Sin cambios." ;;
esac
