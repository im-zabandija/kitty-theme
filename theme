fi

# Extrae el nombre de familia de un font_family, soportando las dos formas:
#   font_family      family="JetBrainsMono Nerd Font" style="..."
#   font_family      Fira Code
_font_of() {  # $1 = archivo .conf ; imprime la familia o nada
    [ -f "$1" ] || return 0
    local line fam
    line="$(grep -m1 '^font_family' "$1" 2>/dev/null)" || return 0
    [ -n "$line" ] || return 0
    fam="$(printf '%s' "$line" | sed -n 's/.*family="\([^"]*\)".*/\1/p')"
    if [ -z "$fam" ]; then
        # forma simple: todo lo que sigue a font_family, sin opciones style=/postscript_name=
        fam="$(printf '%s' "$line" | sed -E 's/^font_family[[:space:]]+//; s/[[:space:]]+(style|postscript_name|features)=.*//')"
    fi
    printf '%s' "$fam"
}

# La fuente que 'theme' fijó (font-active.conf) tiene prioridad; si no fijó
# ninguna, mostramos la que realmente usa kitty (leída de kitty.conf).
current_font="$(_font_of "$FONT_ACTIVE")"
[ -n "$current_font" ] || current_font="$(_font_of "$KITTY_DIR/kitty.conf")"
[ -n "$current_font" ] || current_font="(la default de kitty)"

